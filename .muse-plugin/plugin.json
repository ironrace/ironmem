{
  "schemaVersion": 1,
  "name": "ironmem",
  "displayName": "ironmem",
  "version": "0.5.1",
  "description": "Rust MCP memory backend for Muse Code with semantic search, knowledge graph, automatic migrate-or-init bootstrap, and incremental workspace mining.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "iron-build",
        "path": ".muse-plugin/skills/iron-build/SKILL.md"
      },
      {
        "id": "iron-plan",
        "path": ".muse-plugin/skills/iron-plan/SKILL.md"
      },
      {
        "id": "iron-spec",
        "path": ".muse-plugin/skills/iron-spec/SKILL.md"
      },
      {
        "id": "iron-tdd",
        "path": ".muse-plugin/skills/iron-tdd/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [],
    "mcpServers": [
      {
        "id": "ironmem",
        "transport": "stdio",
        "command": [
          "bash",
          ".muse-plugin/bin/ironmem-mcp.sh",
          "serve"
        ]
      }
    ],
    "reminders": []
  }
}
